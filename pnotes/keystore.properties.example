# Sample keystore.properties template
# Copy this file to keystore.properties in the project root (it is gitignored) and fill it in.
# Without it, release builds are signed with the debug key and cannot be published.

# --- Generate the key once (keep it backed up; losing it means you can never update the app) ---
#   keytool -genkeypair -v \
#     -keystore ~/keys/pnotes-release.jks \
#     -alias pnotes \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# Store the .jks OUTSIDE this repository (it is gitignored here only as a safety net) and make a
# backup copy somewhere safe: an APK signed with a different key can never upgrade-install over
# one signed with this one, so a lost keystore permanently strands existing installs.

# Path to the .jks/.keystore. Absolute, or relative to the project root (not to app/).
storeFile=/absolute/path/to/pnotes-release.jks

storePassword=
keyAlias=pnotes
keyPassword=

# Each value above may instead come from a Gradle property or an environment variable, which is
# how CI signs without writing secrets to disk. The file wins if both are set; a blank value above
# counts as unset, so a half-filled file does not shadow CI's flags:
#
#   file key            Gradle property             environment variable
#   ---------------------------------------------------------------------------
#   storeFile           -Ppnotes.storeFile          PNOTES_STORE_FILE
#   storePassword       -Ppnotes.storePassword      PNOTES_STORE_PASSWORD
#   keyAlias            -Ppnotes.keyAlias           PNOTES_KEY_ALIAS
#   keyPassword         -Ppnotes.keyPassword        PNOTES_KEY_PASSWORD
#
# Set -Ppnotes.requireReleaseSigning=true (or PNOTES_REQUIRE_RELEASE_SIGNING=1) in CI to make the
# build fail outright instead of falling back to the debug key.
#
# Check what a release build will be signed with before building it:
#   ./gradlew printReleaseSigning
